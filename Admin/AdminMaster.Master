<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="AdminMaster.Master.cs" Inherits="Style_On_Rent.Admin.AdminMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Style On Rent - Admin Panel</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #faf7f2;
            color: #111827;
        }

        /* ================= SIDEBAR ================= */
        .sidebar {
            width: 240px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background-color: #242820;
            color: #ffffff;
            padding: 20px 14px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }

        /* ================= LOGO AREA ================= */
        .logo-area {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 5px 8px 20px 8px;
            flex-shrink: 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            margin-bottom: 12px;
        }

        .logo {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            object-fit: cover;
        }

        .brand {
            font-size: 13.5px;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.2;
        }

        .subtitle {
            font-size: 9px;
            color: #a3a89e;
            margin-top: 2px;
            letter-spacing: 0.3px;
        }

        /* ================= MENU ================= */
        .menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .menu li {
            margin-bottom: 4px;
        }

        .menu li a {
            display: flex;
            align-items: center;
            gap: 11px;
            height: 36px;
            padding: 0 12px;
            color: #d1d5db;
            text-decoration: none;
            font-size: 11.5px;
            font-weight: 500;
            border-radius: 5px;
            transition: all 0.15s ease-in-out;
        }

        .menu li a:hover {
            background-color: #363b30;
            color: #ffffff;
        }

        /* ACTIVE MENU ITEM */
        .menu li.active a {
            background-color: #73001e !important;
            color: #ffffff !important;
            font-weight: 600;
        }

        /* ICON */
        .icon {
            width: 16px;
            min-width: 16px;
            text-align: center;
            font-size: 14px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
        }

        /* LOGOUT */
        .logout {
            margin-top: auto;
            padding-top: 14px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* ================= MAIN CONTENT ================= */
        .main-content {
            margin-left: 240px;
            min-height: 100vh;
            background-color: #faf7f2;
            padding: 0;
        }

        /* ================= SCROLLBAR ================= */
        .sidebar::-webkit-scrollbar {
            width: 4px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: #242820;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: #464c3e;
            border-radius: 10px;
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 200px;
            }
            .main-content {
                margin-left: 200px;
            }
            .menu li a {
                font-size: 10.5px;
            }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <!-- ================= SIDEBAR ================= -->
        <aside class="sidebar">

            <!-- LOGO -->
            <div class="logo-area">
                <img src="Images/profile.jpg" class="logo" alt="Style On Rent" />
                <div>
                    <div class="brand">Style On Rent</div>
                    <div class="subtitle">Administrative Console</div>
                </div>
            </div>

            <!-- MENU -->
            <ul class="menu">
                <li id="liDashboard" runat="server">
                    <a href="Admin_Dashboard.aspx">
                        <i class="bi bi-grid icon"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li id="liUsers" runat="server">
                    <a href="Users.aspx">
                        <i class="bi bi-people icon"></i>
                        <span>Users</span>
                    </a>
                </li>
                <li id="liInventory" runat="server">
                    <a href="CholiInventory.aspx">
                        <i class="bi bi-person-badge icon"></i>
                        <span>Choli Inventory</span>
                    </a>
                </li>
                <li id="liOrders" runat="server">
                    <a href="Orders.aspx">
                        <i class="bi bi-bag icon"></i>
                        <span>Orders</span>
                    </a>
                </li>
                <li id="liOffers" runat="server">
                    <a href="Offers.aspx">
                        <i class="bi bi-tag icon"></i>
                        <span>Offers</span>
                    </a>
                </li>
                <li id="liNotification" runat="server">
                    <a href="Notification.aspx">
                        <i class="bi bi-bell icon"></i>
                        <span>Notification</span>
                    </a>
                </li>
                <li id="liPayments" runat="server">
                    <a href="Payments.aspx">
                        <i class="bi bi-credit-card icon"></i>
                        <span>Payments</span>
                    </a>
                </li>
                <li id="liRefundRequest" runat="server">
                    <a href="RefundRequest.aspx">
                        <i class="bi bi-arrow-counterclockwise icon"></i>
                        <span>Refund Request</span>
                    </a>
                </li>
                <li id="liAbout" runat="server">
                    <a href="ManageAboutUs.aspx">
                        <i class="bi bi-info-circle icon"></i>
                        <span>Manage About Us</span>
                    </a>
                </li>
                <li id="liContact" runat="server">
                    <a href="ManageContactUs.aspx">
                        <i class="bi bi-telephone icon"></i>
                        <span>Manage Contact Us</span>
                    </a>
                </li>
                <li id="liHero" runat="server">
                    <a href="ManageHomeHero.aspx">
                        <i class="bi bi-house icon"></i>
                        <span>Manage Home Hero</span>
                    </a>
                </li>
                <li id="liCategories" runat="server">
                    <a href="CholiCategories.aspx">
                        <i class="bi bi-grid-3x3-gap icon"></i>
                        <span>Choli Categories</span>
                    </a>
                </li>
                <li id="liReviews" runat="server">
    <a href="AdminReviewManagement.aspx">
        <i class="bi bi-chat-square-quote icon"></i>
        <span>Customer Reviews</span>
    </a>
</li>
                <li id="liProfile" runat="server">
                    <a href="Admin_Profile.aspx">
                        <i class="bi bi-person icon"></i>
                        <span>Profile</span>
                    </a>
                </li>
                <li id="liSetting" runat="server">
                    <a href="WebsiteSetting.aspx">
                        <i class="bi bi-gear icon"></i>
                        <span>Website Setting</span>
                    </a>
                </li>
                <li id="liLogout" runat="server" class="logout">
                    <a href="Admin_Logout.aspx">
                        <i class="bi bi-box-arrow-right icon"></i>
                        <span>Logout</span>
                    </a>
                </li>
            </ul>

        </aside>

        <!-- ================= MAIN CONTENT ================= -->
        <main class="main-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </form>
</body>
</html>